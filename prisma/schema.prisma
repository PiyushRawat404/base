generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model patients {
  clientno Int     @id @default(autoincrement())
  fullname String  @db.VarChar(20)
  phoneno  Int     @unique @default(autoincrement())
  gender   String? @db.VarChar(10)
  problem  String? @db.VarChar(50)
  age     Int   @db.Integer
}
