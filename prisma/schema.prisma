generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model patients {
  clientno    Int            @id @default(autoincrement())
  fullname    String         @db.VarChar(20)
  phoneno     Int?           @unique 
  gender      String?        @db.VarChar(10)
  problem     String?        @db.VarChar(50)
  age         Int?           @db.Integer
  email       String         @unique
  password    String         @unique
}

enum branch{
  GYANE
  ORTHO
  ENT
  DENTIST
  NEURO
}
enum timing{
  MORNING
  EVENING
  NIGHT
}
model doctor{
  id            Int         @id @default(autoincrement())
  name          String    
  specialist    branch 
  shift         timing 
  email         String      @unique
  password      String      @unique
}